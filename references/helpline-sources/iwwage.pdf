<style>
	.myYearSwiper {
		max-width: 802px;
		padding: 5px 0;
	}
	
	.myYearSwiper .swiper-slide {
		width: auto;
	}

	.myYearSwiper a {
		color: #BCBEC0;
		display: inline-block;
		padding: 8px 36px;
		border: 1px solid #BCBEC0;
		border-radius: 4px;
	}
	
	.myYearSwiper a:hover,
	.myYearSwiper a.active {
		color: white;
		background: #CAAF27;
	}

	.myYearSwiper p {
		display: none;
	}
	
	.swiper-next,
	.swiper-prev {
		cursor: pointer;
	}
</style>
