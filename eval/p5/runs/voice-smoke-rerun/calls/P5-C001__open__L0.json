    "start_s": 30.25,
    "end_s": 32.25
   },
   {
    "id": 10,
    "speaker": "bot",
    "step": "context",
    "text": "धन्यवाद। आपने हाल ही में नमूना बैंक से जो लोन लिया, उसके बारे में कुछ सवाल हैं।",
    "asks": null,
