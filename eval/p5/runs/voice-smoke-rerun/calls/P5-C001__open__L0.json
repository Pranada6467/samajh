    "start_s": 12.98,
    "end_s": 18.02
   },
   {
    "id": 6,
    "speaker": "bot",
    "step": "disclosure",
    "text": "हम आपसे कभी ओ-टी-पी, पिन, पासवर्ड या खाता नंबर नहीं माँगेंगे।",
