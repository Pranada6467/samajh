    "product_id": null,
    "start_s": 18.17,
    "end_s": 23.05
   },
   {
    "id": 7,
    "speaker": "bot",
    "step": "disclosure",
    "text": "शक हो तो फ़ोन रखकर नमूना बैंक कस्टमर केयर पर ख़ुद पूछ सकते हैं।",
