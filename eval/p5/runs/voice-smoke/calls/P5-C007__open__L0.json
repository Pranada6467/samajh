   },
   {
    "id": 25,
    "speaker": "customer",
    "step": "teach_back",
    "text": "मेरी मर्ज़ी थी, उन्होंने कहा, \"अच्छा रहेगा।\"",
    "asks": null,
    "product_id": null,
