    "end_s": 124.22
   },
   {
    "id": 36,
    "speaker": "bot",
    "step": "teach_back",
    "text": "अगर आप उसमें लगे पैसे वापस चाहें, तो क्या होगा? आपको क्या लगता है?",
    "asks": "features",
